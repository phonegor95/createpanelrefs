/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for stub-testing the gCNV cohort + postprocess chain
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The stock `test` profile runs `tools = 'cnvkit'`, so it never enters
    GERMLINECNVCALLER_COHORT and none of this fork's additions are exercised by
    CI. This profile turns every optional branch on so that the channel plumbing
    -- which is where the bugs in this fork's history actually lived -- is
    type-checked end to end.

    Every added process ships a `stub:` block, so run it with -stub-run: no
    reference bundles, SNP panels or AnnotSV annotations are needed.

    Use as follows:
        nextflow run phonegor95/createpanelrefs -profile test_gcnv,<docker/singularity> \
            -stub-run --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'gCNV postprocess stub-test profile'
    config_profile_description = 'Exercises the full post-GermlineCNVCaller chain under -stub-run'

    // Input data
    input = "${projectDir}/tests/csv/1.0.0/bam.csv"

    // Main options
    tools = 'germlinecnvcaller'

    // Germlinecnvcaller options. The ploidy priors normally come from the
    // igenomes genome attribute, which the chr21 test genome does not define;
    // point at the bundled asset so the profile stands alone.
    gcnv_scatter_content = 2
    gcnv_ploidy_priors   = "${projectDir}/assets/hg38.contig_ploidy_priors_homo_sapiens.tsv"

    // Small reference genome
    genome        = 'GRCh38.chr21.testdata'
    igenomes_base = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data'

    // --- fork additions: enable every optional branch ----------------------
    // Under -stub-run these paths are never opened, but they must be non-null
    // for the `ext.when` gates and the subworkflow's `if` guards to select the
    // optional branches, which is the point of this profile.
    allelic_snp_vcf     = "${projectDir}/tests/stub/common_snps.vcf.gz"
    allelic_rescue      = true
    hba_classifier      = true
    annotsv_annotations = "${projectDir}/assets"

    // Left off deliberately: it makes a live external API call, which must
    // never happen in CI.
    hba_gemini_verdict = false

    // The cohort is 1-2 samples here, below recur_min_cohort, so the
    // recurrence filter correctly degrades to a no-op. That is the behaviour
    // being asserted -- do not raise this to force flags.
}
