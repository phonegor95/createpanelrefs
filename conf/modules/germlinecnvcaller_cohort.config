/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_ANNOTATEINTERVALS' {
        ext.args   = { '--imr OVERLAPPING_ONLY' }
        ext.prefix = { " ${meta.id}_annotated" }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_COLLECTREADCOUNTS' {
        ext.args   = { [
            "--format ${params.gcnv_readcount_format}",
            "--imr OVERLAPPING_ONLY"
        ].join(" ") }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_DETERMINEGERMLINECONTIGPLOIDY' {
        ext.args   = { '--imr OVERLAPPING_ONLY' }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_FILTERINTERVALS' {
        ext.args   = { '--imr OVERLAPPING_ONLY' }
        ext.prefix = { " ${meta.id}_filtered" }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_GERMLINECNVCALLER' {
        ext.args   = { '--imr OVERLAPPING_ONLY --run-mode COHORT' }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_INTERVALLISTTOOLS' {
        ext.args   = { [
            "--SUBDIVISION_MODE INTERVAL_COUNT",
            "--SCATTER_CONTENT ${params.gcnv_scatter_content}"
        ].join(" ") }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_PREPROCESSINTERVALS' {
        ext.args   = { [
            "--imr OVERLAPPING_ONLY",
            "--padding ${params.gcnv_padding}",
            "--bin-length ${params.gcnv_bin_length}"
        ].join(" ") }
    }

    withName: '.*GERMLINECNVCALLER_COHORT:GATK4_POSTPROCESSGERMLINECNVCALLS' {
        ext.args = {"--allosomal-contig chrX --allosomal-contig chrY"}
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/postprocess/${meta.id}" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Sex-aware filtering of the genotyped segments. Keeps only confident DEL/DUP
    // calls (NP>=2), with sex-specific handling of the allosomes: females drop
    // chrY entirely, males use a relaxed QS threshold for hemizygous chrX/chrY
    // deletions. meta.sex is derived from the inferred chrX ploidy in the
    // GERMLINECNVCALLER_COHORT subworkflow.
    withName: '.*GERMLINECNVCALLER_COHORT:BCFTOOLS_FILTER_GCNV' {
        ext.args = {
            meta.sex == 'F'
                ? "-i 'ALT!=\".\" && CHROM!=\"chrY\" && FORMAT/NP>=2 && ( (ALT=\"<DEL>\" && FORMAT/CN=1 && FORMAT/QS>=100) || (ALT=\"<DEL>\" && FORMAT/CN=0 && FORMAT/QS>=400) || (ALT=\"<DUP>\" && FORMAT/QS>=100) )'"
                : "-i 'ALT!=\".\" && FORMAT/NP>=2 && ( (ALT=\"<DEL>\" && FORMAT/CN=1 && FORMAT/QS>=100) || (ALT=\"<DEL>\" && FORMAT/CN=0 && CHROM!=\"chrX\" && CHROM!=\"chrY\" && FORMAT/QS>=400) || (ALT=\"<DEL>\" && FORMAT/CN=0 && (CHROM=\"chrX\" || CHROM=\"chrY\") && FORMAT/QS>=100) || (ALT=\"<DUP>\" && FORMAT/QS>=100) )'"
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/postprocess/${meta.id}" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Cohort-recurrence (two-arm) soft filter. One process over the whole
    // cohort -> per-sample soft-flagged + PASS-only VCFs. Thresholds come from
    // params.recur_* (see nextflow.config).
    withName: '.*GERMLINECNVCALLER_COHORT:COHORT_RECURRENCE_FILTER' {
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/recurfilt" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst('^recurfilt/', '') }
        ]
    }

    // Allelic LOH confirmation of PASS deletions. Skipped unless a common-SNP
    // sites VCF is provided via params.allelic_snp_vcf.
    withName: '.*GERMLINECNVCALLER_COHORT:ALLELIC_LOH' {
        ext.when   = { params.allelic_snp_vcf }
        ext.prefix = { "${meta.id}" }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/allelic_loh" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Route-A allelic CNV rescue (segdup-masked focal dels). Opt-in; needs a
    // common-SNP panel (params.allelic_snp_vcf) and params.allelic_rescue.
    withName: '.*GERMLINECNVCALLER_COHORT:ALLELIC_RESCUE' {
        ext.when   = { params.allelic_rescue && params.allelic_snp_vcf }
        ext.prefix = { "${meta.id}" }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/allelic_rescue" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*GERMLINECNVCALLER_COHORT:ALLELIC_RESCUE_COHORT' {
        ext.when   = { params.allelic_rescue && params.allelic_snp_vcf }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/allelic_rescue" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst('^rescue_contrast/', '') }
        ]
    }

    // HBA alpha-globin classifier (Sentieon-schema YAML). Opt-in; needs the SNP panel.
    withName: '.*GERMLINECNVCALLER_COHORT:HBA_CLASSIFIER' {
        ext.when   = { params.hba_classifier && params.allelic_snp_vcf }
        ext.prefix = { "${meta.id}" }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/hba" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Independent LLM second-opinion on the HBA call, for the manual-review
    // samples only. Advisory: nothing downstream consumes it, so without a
    // publishDir the verdict would only ever exist inside work/.
    withName: '.*GERMLINECNVCALLER_COHORT:GEMINI_VERDICT' {
        ext.when   = { params.hba_classifier && params.allelic_snp_vcf && params.hba_gemini_verdict }
        ext.prefix = { "${meta.id}" }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/hba/verdict" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-sample CNV QC outlier report (cohort-level; always runs).
    withName: '.*GERMLINECNVCALLER_COHORT:CNV_QC_OUTLIER' {
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/qc" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-sample AnnotSV annotation of the PASS survivors. Skipped unless
    // params.annotsv_annotations points at an AnnotSV annotation bundle.
    withName: '.*GERMLINECNVCALLER_COHORT:ANNOTSV' {
        ext.when   = { params.annotsv_annotations }
        ext.args   = { "-genomeBuild ${params.annotsv_genome_build}" }
        ext.prefix = { "${meta.id}" }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/annotsv" },
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // knotAnnotSV HTML report + XLSM workbook from the AnnotSV TSV. Same gate as
    // AnnotSV (needs its TSV); publishes only the relevant artifact per alias.
    withName: '.*GERMLINECNVCALLER_COHORT:KNOTANNOTSV_HTML' {
        ext.when   = { params.annotsv_annotations }
        ext.prefix = { "${meta.id}" }
        // UCSC hyperlink build must match the AnnotSV genome build (GRCh38 -> hg38).
        ext.args   = { params.annotsv_genome_build == 'GRCh37' ? '--genomeBuild hg19' : '--genomeBuild hg38' }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/knotannotsv" },
                pattern: '*.html'
        ]
    }

    withName: '.*GERMLINECNVCALLER_COHORT:KNOTANNOTSV_XLSM' {
        ext.when   = { params.annotsv_annotations }
        ext.prefix = { "${meta.id}" }
        ext.args   = { params.annotsv_genome_build == 'GRCh37' ? '--genomeBuild hg19' : '--genomeBuild hg38' }
        publishDir = [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/germlinecnvcaller/knotannotsv" },
                pattern: '*.xlsm'
        ]
    }
}
